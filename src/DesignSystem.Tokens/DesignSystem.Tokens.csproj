<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<Description>Norse.DesignSystem.Tokens: 100%-generated output of Naglfar's Style Dictionary pipeline — FluentTokenSeed (AccentBaseColor/NeutralBaseColor, for FluentUI Blazor's DesignTokens) and a native wwwroot/norse-design-tokens.css static web asset (plain semantic color custom properties, no third-party dependency). Versioned identically to @norsearchitecture/design-tokens; published in the same release step. No hand-authored C# anywhere in this project.</Description>
		<NorseFrontendPlatforms>All</NorseFrontendPlatforms>
	</PropertyGroup>
	<!--
		node_modules never lands inside the repo tree: it's installed straight to
		NORSE_BUILD_ARTIFACTS_DIR (container-native disk, or the Windows-native dir
		Redirect-BuildArtifacts.ps1 sets), same as .NET's own BaseIntermediateOutputPath
		redirect in the root Directory.Build.props. A symlink/junction back into the repo
		doesn't work here — one OS's reparse point is unreadable to the other over the
		9p-bridged mount — so scripts/loader-register.mjs (a Node module customization
		hook, registered from package.json's "build" script via Node's module preload
		option) redirects style-dictionary's bare-specifier resolution to
		$(NORSE_BUILD_ARTIFACTS_DIR)/Naglfar/node_modules at import time instead.
		scripts/loader-resolve.mjs reads NORSE_BUILD_ARTIFACTS_DIR itself — the same
		persistent var _BunInstallDir below is keyed off — so `bun run build`/`bun run test`
		behave identically whether run standalone or via the .NET build; no value needs
		handing down through the Exec task. Falls back to plain in-tree node_modules when
		NORSE_BUILD_ARTIFACTS_DIR is unset.

		Project-level, not inside the target: RestoreDesignTokenPackages reads these from
		its Inputs/Outputs attributes, which MSBuild evaluates before the target body runs.
	-->
	<PropertyGroup>
		<_BunProjectDir>$(MSBuildProjectDirectory)/../..</_BunProjectDir>
		<_BunInstallDir Condition="'$(NORSE_BUILD_ARTIFACTS_DIR)' != ''">$(NORSE_BUILD_ARTIFACTS_DIR)/Naglfar</_BunInstallDir>
		<_BunInstallDir Condition="'$(NORSE_BUILD_ARTIFACTS_DIR)' == ''">$(_BunProjectDir)</_BunInstallDir>
		<_BunRestoreStamp>$(_BunInstallDir)/node_modules/.norse-restore.stamp</_BunRestoreStamp>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../../dist/csharp/FluentTokenSeed.g.cs" Link="FluentTokenSeed.g.cs" />
		<Content Include="../../dist/css/tokens.css" Link="wwwroot/norse-design-tokens.css" />
	</ItemGroup>
	<!--
		Keyed to the manifests, not to "does node_modules exist" — NORSE_BUILD_ARTIFACTS_DIR
		is deliberately persistent across builds, so an existence check installs once and then
		never again: a later dependency bump would resolve the previous tree and generate
		tokens with stale tooling, silently. Bun leaves no install record of its own in
		node_modules, so Outputs names a stamp this target touches after each successful install;
		MSBuild's up-to-date check reinstalls exactly when a manifest is newer than the stamp (or
		node_modules is gone, taking the stamp with it), and skips otherwise. package.json rides
		in Inputs alongside the lockfile because a frozen `bun install` refuses to run at all when
		the two disagree — better to reinstall than to fail the next build on a stale pair.
	-->
	<Target Name="RestoreDesignTokenPackages"
			Inputs="$(_BunProjectDir)/package.json;$(_BunProjectDir)/bun.lock"
			Outputs="$(_BunRestoreStamp)">
		<MakeDir Directories="$(_BunInstallDir)" Condition="'$(NORSE_BUILD_ARTIFACTS_DIR)' != ''" />
		<Copy SourceFiles="$(_BunProjectDir)/package.json;$(_BunProjectDir)/bun.lock" DestinationFolder="$(_BunInstallDir)" Condition="'$(NORSE_BUILD_ARTIFACTS_DIR)' != ''" />
		<Exec Command="bun install --frozen-lockfile --cwd &quot;$(_BunInstallDir)&quot;" WorkingDirectory="$(_BunProjectDir)" />
		<Touch Files="$(_BunRestoreStamp)" AlwaysCreate="true" />
	</Target>
	<Target Name="BuildDesignTokens" DependsOnTargets="RestoreDesignTokenPackages" BeforeTargets="Build;ResolveStaticWebAssetsConfiguration;AssignTargetPaths;CoreCompile">
		<Exec Command="bun run build" WorkingDirectory="$(_BunProjectDir)" />
	</Target>
</Project>
